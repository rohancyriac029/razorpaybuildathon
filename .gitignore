# --- databases ---------------------------------------------------------
# Every SQLite file is ignored by default: they are runtime state, and the
# dev database is regenerated by `npm run db:push && npm run demo:prep`.
*.sqlite
*.sqlite-journal
*.sqlite-shm
*.sqlite-wal

# ONE exception, deliberately committed: it carries the benchmark results the
# dashboard scoreboard reads AND the LLM response cache for the current system
# prompt, so `npm run demo:prep` works on a fresh clone with no model and no
# API key. Any change to the prompt or tool schemas invalidates that cache.
!salvage-pilot3.sqlite

# --- working notes, run artifacts, exploratory scripts -----------------
# Kept locally, not part of the deliverable. README.md and DEMO.md carry the
# findings that matter.
SALVAGE-*.md
TRACK-*.md
DEMO-EVIDENCE-*
PILOT*-OUTPUT.md
*.log
*.pgn
page-check.html

# Scripts used to derive the pilot findings; not demo inputs and not wired
# into package.json.
scripts/compare-anchoring.ts
scripts/diagnose-pilot.ts
scripts/stratify.ts
scripts/why-auth-abandoned.ts
