RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
ANTHROPIC_API_KEY=
# [v2.1 deviation] Spec §3.2/§6 specify the Anthropic SDK. This build supports
# a Gemini adapter behind the same LlmClient interface (see src/llm/) so it
# runs on a free-tier key while ANTHROPIC_API_KEY is unavailable — swap
# LLM_PROVIDER back to "anthropic" the moment a key exists; no other code
# changes needed. Real, corrected number from PROGRESS.md block 11 (an
# earlier estimate of 1,500 req/day here was wrong): gemini-3.5-flash-lite's
# free tier is 30 RPM AND a much tighter 500 requests/DAY, confirmed live via
# a real 429 RESOURCE_EXHAUSTED response — exhausted by this build's own
# smoke-testing plus one real eval attempt. Fine for smoke tests and small
# runs; not enough headroom to reliably finish a full 120x3 headline eval in
# one sitting. See LLM_PROVIDER=ollama below for the option that removed
# this ceiling entirely.
GEMINI_API_KEY=
# [v2.1 addition, block 11] A third provider, local and free of both Gemini's
# quota and any API key requirement — added specifically because the
# quota above blocked finishing the headline eval. Needs Ollama running
# locally (https://ollama.com) with a model pulled first: `ollama pull
# qwen2.5:7b`. Verified live 2026-09-04: llama3.2:3b (the smaller, faster
# default) is NOT reliable enough for this build's multi-turn, schema-strict
# tool-calling loop — it consistently invents wrong field names even after
# being shown the exact Zod validation error, and drops out of tool-calling
# mode into plain prose after 2-3 correction rounds. qwen2.5:7b (~4.7GB,
# needs ~5GB VRAM or will run slower on CPU) passed the same live test
# cleanly and repeatably — see src/llm/ollama-client.ts's module doc for
# the two mitigations (a forced-tool-call reminder, and a last-resort
# extractor for a JSON tool call embedded in a text response) this client
# needed even with qwen2.5:7b to reach that reliability.
LLM_PROVIDER=anthropic
GEMINI_MODEL=gemini-3.5-flash-lite
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434
DATABASE_URL=file:./salvage.sqlite
KILL_SWITCH=false
GLOBAL_EXEC_PER_HOUR=20
GLOBAL_CONTACTS_PER_DAY=50
STALENESS_CUTOFF_DAYS=7
VALUE_CEILING_PAISE=500000
