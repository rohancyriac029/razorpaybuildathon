RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
ANTHROPIC_API_KEY=
# [v2.1 deviation] Spec §3.2/§6 specify the Anthropic SDK. This build supports
# a Gemini adapter behind the same LlmClient interface (see src/llm/) so it
# runs on a free-tier key while ANTHROPIC_API_KEY is unavailable — swap
# LLM_PROVIDER back to "anthropic" the moment a key exists; no other code
# changes needed. See PROGRESS.md block 6 for the rate-limit numbers behind
# choosing gemini-3.5-flash-lite specifically: verified live 2026-09-02,
# 30 RPM / 1,500 requests/day free tier, real function-calling support
# confirmed by a direct API call. Comfortably covers the eval's estimated
# few-hundred calls, especially combined with the response cache spec
# §5.8 already requires. The model line moved once already during this
# build (2.5 -> 3.5 for new keys) — re-verify before relying on this id.
GEMINI_API_KEY=
LLM_PROVIDER=anthropic
GEMINI_MODEL=gemini-3.5-flash-lite
DATABASE_URL=file:./salvage.sqlite
KILL_SWITCH=false
GLOBAL_EXEC_PER_HOUR=20
GLOBAL_CONTACTS_PER_DAY=50
STALENESS_CUTOFF_DAYS=7
VALUE_CEILING_PAISE=500000
